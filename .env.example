# ============ Telegram Bot ============
# Отримай токен у @BotFather в Telegram:
#   /newbot → дай назву → дай username (закінчується на _bot)
#   BotFather дасть рядок типу 1234567890:ABCdef...
TG_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Канал, з якого парсимо. Може бути:
#   - @username (якщо канал публічний)
#   - -1001234567890 (числовий ID для приватного каналу)
# ВАЖЛИВО: бот має бути адміном цього каналу!
TG_SOURCE=@your_channel

# ============ Replicate ============
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your_token_here

# ============ Адмін-панель ============
# Логін: admin, пароль — цей:
ADMIN_PASSWORD=change_me_please

# ============ Сайт ============
SITE_NAME=SAHARA
BASE_URL=http://localhost:8000
